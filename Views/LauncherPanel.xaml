                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Height="44" Background="#FF1F1F23" CornerRadius="8,8,0,0">
                    <Grid Margin="16,0">
                        <TextBlock Text="{DynamicResource PageMore}" Foreground="White" FontSize="14"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#FF252529" Margin="0,1,0,0" ClipToBounds="True">
                    <ScrollViewer Style="{StaticResource CustomScrollBar}"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                        <StackPanel Margin="18,14">

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsCardTitle}" Text="{DynamicResource MoreAbout}"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SettingsItemLabel}" Text="{DynamicResource MoreLauncherName}"/>
                                        <TextBlock Grid.Column="1" Text="DIL" Foreground="White" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SettingsItemLabel}" Text="{DynamicResource MoreVersion}"/>
                                        <TextBlock x:Name="MoreVersionText" Grid.Column="1" Text="1.0.0" Foreground="White"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SettingsItemLabel}" Text="{DynamicResource MoreRuntime}"/>
                                        <TextBlock x:Name="MoreRuntimeText" Grid.Column="1" Foreground="White"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SettingsItemLabel}" Text="{DynamicResource MoreProjectUrl}"/>
                                        <TextBlock Grid.Column="1" Text="github.com/aaa112222/DynamicIsland-Launcher" Foreground="#FF4A90F5"
                                                   FontSize="12" VerticalAlignment="Center" Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsCardTitle}" Text="{DynamicResource MoreQuickActions}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="{DynamicResource MoreOpenGameDir}" Style="{StaticResource CardButton}" Height="30"
                                                FontSize="12" Margin="0,0,10,0" Click="MoreOpenGameDir_Click"/>
                                        <Button Content="{DynamicResource MoreOpenJavaDir}" Style="{StaticResource CardButton}" Height="30"
                                                FontSize="12" Margin="0,0,10,0" Click="MoreOpenJavaDir_Click"/>
                                        <Button Content="{DynamicResource MoreClearCache}" Style="{StaticResource CardButton}" Height="30"
                                                FontSize="12" Margin="0,0,10,0" Click="MoreClearCache_Click"/>
                                        <Button x:Name="MoreCheckUpdateBtn" Content="{DynamicResource MoreCheckUpdate}" Style="{StaticResource CardButton}" Height="30"
                                                FontSize="12" Click="MoreCheckUpdate_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsCardTitle}" Text="{DynamicResource MoreChangelog}"/>

                                    <TextBlock Foreground="#FFB0B0B4" FontSize="12" TextWrapping="Wrap" LineHeight="22"
                                               Text="{DynamicResource ChangelogContent}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsCardTitle}" Text="{DynamicResource MoreCredits}"/>

                                    <TextBlock Foreground="#FFB0B0B4" FontSize="12" TextWrapping="Wrap" LineHeight="22"
                                               Text="{DynamicResource CreditsContent}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>