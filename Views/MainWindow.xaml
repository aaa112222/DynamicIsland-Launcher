<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Manual"
        Width="220" Height="40"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Border x:Name="MainPill"
            CornerRadius="{Binding PillRadius, RelativeSource={RelativeSource AncestorType=Window}}"
            Background="Black"
            BorderBrush="Gray"
            BorderThickness="1"
            ClipToBounds="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Height="40"
            Width="160"
            RenderOptions.BitmapScalingMode="HighQuality"
            MouseEnter="MainPill_MouseEnter"
            MouseLeave="MainPill_MouseLeave">
        <Grid>
            <Grid x:Name="ClockContainer"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Border x:Name="SkeletonBar"
                        Width="58" Height="3" CornerRadius="1.5"
                        Background="#44FFFFFF" ClipToBounds="True"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SkeletonTranslate"/>
                    </Border.RenderTransform>
                    <Border x:Name="SkeletonShine"
                            Width="24" Height="3" CornerRadius="1.5"
                            Background="White" Opacity="0.9"
                            HorizontalAlignment="Left"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SkeletonShineTranslate"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock x:Name="TimeText"
                           Text="11:47"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TimeTranslate"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <Grid x:Name="ProgressContainer"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ProgressTranslate"/>
                </Grid.RenderTransform>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HoverTimeText"
                           Grid.Column="0"
                           Text="11:47"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           IsHitTestVisible="False"
                           Opacity="0"/>

                <ProgressBar x:Name="DownloadProgress"
                             Grid.Column="1"
                             Width="120" Height="4"
                             Minimum="0" Maximum="100"
                             Value="0"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track"
                                        Background="#40FFFFFF"
                                        CornerRadius="2"/>
                                <Border x:Name="PART_Indicator"
                                        Background="White"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>

                <TextBlock x:Name="HoverPercentText"
                           Grid.Column="2"
                           Text="0%"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           IsHitTestVisible="False"
                           Opacity="0"/>
            </Grid>

            <Grid x:Name="ExpandedContainer"/>

            <Grid x:Name="NotificationContainer"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Visibility="Collapsed"
                  Panel.ZIndex="20">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="NotificationTranslate"/>
                </Grid.RenderTransform>
                <TextBlock x:Name="NotificationText"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Opacity="0"
                           TextWrapping="Wrap"
                           MaxWidth="700"
                           TextAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>